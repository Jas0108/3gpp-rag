# =============================================================================
# 3GPP RAG Chatbot — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# ── PDF ───────────────────────────────────────────────────────────────────────
PDF_FILENAME=23501-ic0.pdf

# ── Document metadata (do not change unless ingesting a different spec) ────────
SPECIFICATION=3GPP TS 23.501
RELEASE=18
VERSION=V18.12.0

# ── LLM provider ──────────────────────────────────────────────────────────────
# Supported: openrouter | openai | google
LLM_PROVIDER=openrouter

# Popular FREE models on OpenRouter:
# - meta-llama/llama-3.3-70b-instruct:free  (Recommended)
# - google/gemini-2.0-flash-exp:free
# - deepseek/deepseek-r1:free
# - qwen/qwen-2.5-72b-instruct:free
LLM_MODEL=google/gemma-2-27b-it:free

# Paste your OpenRouter API Key below (starts with sk-or-v1-...)
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_COLLECTION=ts23501

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_TARGET_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
CHUNK_MIN_CHARS=100
CHUNK_MAX_CHARS=6000

# ── Retrieval ─────────────────────────────────────────────────────────────────
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
HYBRID_TOP_N=20

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# ── Context expansion ─────────────────────────────────────────────────────────
CONTEXT_EXPAND_ENABLED=true
CONTEXT_EXPAND_WINDOW=1

# ── Evidence gate ─────────────────────────────────────────────────────────────
EVIDENCE_THRESHOLD=0.15
EVIDENCE_MIN_CHUNKS=1

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
